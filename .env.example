# Required for multimodal image & video recipe extraction
GEMINI_API_KEY=

# Optional: Postgres database URL (Supabase, Neon, or Vercel Postgres)
# When omitted, falls back cleanly to local JSON storage + browser persistence.
DATABASE_URL=

# Optional: Pinterest Developer App OAuth v5 credentials (for private & 500+ pin boards)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/callback

# Optional: Secret for signing OAuth session cookies (defaults to dev-only fallback locally)
SESSION_SECRET=
